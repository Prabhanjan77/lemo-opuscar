#!/usr/bin/env python3
"""Small ffprobe compatibility shim for the user-local imageio-ffmpeg install.

The imageio-ffmpeg wheel intentionally ships ffmpeg but not ffprobe. The
Lemo-Opuscar mux script only asks ffprobe for audio presence and duration, so
those two queries are implemented with stdlib WAV parsing and ffmpeg's stable
input probe output.
"""
import re
import subprocess
import sys
import wave


def duration(path):
    try:
        with wave.open(path, "rb") as wav:
            return wav.getnframes() / wav.getframerate()
    except Exception:
        pass
    probe = subprocess.run(
        ["ffmpeg", "-hide_banner", "-i", path],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    match = re.search(r"Duration:\s*(\d+):(\d+):(\d+(?:\.\d+)?)", probe.stderr)
    if not match:
        return 0.0
    return int(match.group(1)) * 3600 + int(match.group(2)) * 60 + float(match.group(3))

args = sys.argv[1:]
path = args[-1] if args else ""
joined = " ".join(args)
if "stream=codec_type" in joined:
    try:
        with wave.open(path, "rb"):
            print("audio")
    except Exception:
        probe = subprocess.run(
            ["ffmpeg", "-hide_banner", "-i", path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        print("audio" if re.search(r"Audio:", probe.stderr) else "")
elif "format=duration" in joined:
    print(f"{duration(path):.6f}")
else:
    print(f"{duration(path):.6f}")
